# Utility command for edit_cache

build definitions/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /thunder_root/build/ThunderInterfaces/definitions && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build definitions/edit_cache: phony definitions/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build definitions/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /thunder_root/build/ThunderInterfaces/definitions && /usr/bin/cmake --regenerate-during-build -S/thunder_root/ThunderInterfaces -B/thunder_root/build/ThunderInterfaces
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build definitions/rebuild_cache: phony definitions/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build definitions/list_install_components: phony


#############################################
# Utility command for install

build definitions/CMakeFiles/install.util: CUSTOM_COMMAND definitions/all
  COMMAND = cd /thunder_root/build/ThunderInterfaces/definitions && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build definitions/install: phony definitions/CMakeFiles/install.util


#############################################
# Utility command for install/local

build definitions/CMakeFiles/install/local.util: CUSTOM_COMMAND definitions/all
  COMMAND = cd /thunder_root/build/ThunderInterfaces/definitions && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build definitions/install/local: phony definitions/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build definitions/CMakeFiles/install/strip.util: CUSTOM_COMMAND definitions/all
  COMMAND = cd /thunder_root/build/ThunderInterfaces/definitions && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build definitions/install/strip: phony definitions/CMakeFiles/install/strip.util

