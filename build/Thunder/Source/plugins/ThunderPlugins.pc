prefix=/thunder_root/install
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include/Thunder

Name: ThunderPlugins
Version: 5.3.0
Description: Basic library to realize the glue between a proprietary plugin and the framework host.

Libs: -L${libdir}  -lThunderPlugins -lThunderCore -lThunderCryptalgo -lThunderMessaging -lThunderCOM -lThunderWebSocket 
Cflags: -I${includedir}    -D_TRACE_LEVEL=0 -D__CORE_MESSAGING__ -D__CORE_NO_WCHAR_SUPPORT__
