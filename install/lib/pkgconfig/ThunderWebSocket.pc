prefix=/thunder_root/install
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include/Thunder

Name: ThunderWebSocket
Version: 5.3.0
Description: library containing HTTP protocol (RFC2616), WebSocket (RFC6455) and JSONRPC functionality.

Libs: -L${libdir}  -lThunderWebSocket 
Cflags: -I${includedir}   
